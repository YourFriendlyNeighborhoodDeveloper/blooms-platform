# Placeholders only. Copy to .env for local work, and set real values in your host's secret store
# for anything deployed. Never commit real values. See docs/operations.md and docs/integrations.md.

# ---------- Core ----------
# development | test | staging | production
APP_ENV=development
PORT=8787
# The public address of the site. Must be https once deployed.
PUBLIC_BASE_URL=http://localhost:5173
# Required once deployed. Locally it defaults to the docker-compose database.
DATABASE_URL=postgres://blooms:blooms_dev_only@127.0.0.1:54329/blooms_dev
DATABASE_SSL=false
# Required once deployed: at least 32 random characters. For example: openssl rand -base64 48
SESSION_SECRET=
# true when running behind a reverse proxy you control, so client addresses are read correctly.
TRUST_PROXY=false
# true serves the built site from this server.
SERVE_STATIC=false
# true runs the background worker inside the web process. Separate processes are recommended in production.
WORKER_EMBEDDED=false
# Optional. Errors are also POSTed here, for example to a Slack incoming webhook or error service.
ERROR_WEBHOOK_URL=

# ---------- Site mode ----------
# Build-time switch. Only set this to production once the owner has approved launch. It removes the
# concept badge, concept footer wording, and noindex. Anything else builds a noindex preview.
SITE_MODE=
SITE_URL=

# ---------- Payments ----------
# disabled | mock | stripe. Mock is simulated, and refuses to start in production.
PAYMENTS_MODE=mock
# Use a key from the client's own Stripe account. Test keys start sk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A live key also requires APP_ENV=production and this flag, set by a person after the launch
# checklist passes. Without all three the server refuses to start.
LIVE_PAYMENTS_APPROVED=false

# ---------- Email ----------
# log records messages without sending. resend or smtp send for real.
EMAIL_PROVIDER=log
# A verified sender on the business's own domain.
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_URL=
# Outside production, real providers can only reach these comma-separated addresses and numbers.
MESSAGE_ALLOWLIST=

# ---------- Text messages (optional) ----------
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Set true only once A2P 10DLC brand and campaign registration is approved.
TWILIO_A2P_APPROVED=false

# ---------- File storage ----------
# local keeps files on disk, which needs a persistent volume. s3 works with any S3-compatible service.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Google Calendar (optional, one-way push) ----------
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
