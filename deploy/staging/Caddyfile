# The staging proxy. https://localhost:8443 serves this machine with a local certificate, and the
# optional tunnel reaches the plain :80 site inside the Docker network, with TLS at Cloudflare's edge.
{
	local_certs
	skip_install_trust
}

(app) {
	encode zstd gzip
	log {
		output stdout
		format json
	}
	# The team dashboard, its API and the test mailbox sit behind a second password, checked here
	# before the application's own sign-in. The shop, tracking pages and simulated payments stay open.
	# gate.caddy holds only a bcrypt hash. scripts/staging.sh writes it, and it is never committed.
	@staff path /admin /admin/* /api/admin /api/admin/* /mailbox /mailbox/*
	import /etc/caddy/gate.caddy
	handle /mailbox* {
		reverse_proxy mailpit:8025
	}
	handle {
		reverse_proxy web:8787
	}
}

localhost {
	import app
}

:80 {
	import app
}
