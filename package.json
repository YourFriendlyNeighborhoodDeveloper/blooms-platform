{
  "name": "blooms-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Commerce, wedding planning and operations platform for Blooms Boutique & Floral (Saginaw, MI). An independent concept by Abraxas Technologies until the owner approves launch.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api,worker -c magenta,blue,yellow \"vite\" \"tsx watch server/index.ts\" \"tsx watch server/worker.ts\"",
    "build": "tsc -b && vite build && node --disable-warning=ExperimentalWarning scripts/postbuild.mjs && npm run build:server",
    "build:production": "SITE_MODE=production npm run build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "images": "node scripts/fetch-images.mjs",
    "og": "node scripts/og-image.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:worker": "tsx watch server/worker.ts",
    "build:concept": "VITE_PLATFORM=off tsc -b && VITE_PLATFORM=off vite build && VITE_PLATFORM=off node --disable-warning=ExperimentalWarning scripts/postbuild.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist-server/index.js",
    "start:worker": "node dist-server/worker.js",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "tsx server/db/cli.ts migrate",
    "db:seed": "tsx server/db/cli.ts seed",
    "db:seed:demo": "tsx server/db/cli.ts seed-demo",
    "db:reset": "tsx server/db/cli.ts reset",
    "db:check": "tsx server/db/cli.ts check",
    "db:types": "tsx server/db/cli.ts migrate && kysely-codegen --dialect postgres --url postgres://blooms:blooms_dev_only@127.0.0.1:54329/blooms_dev --out-file server/db/types.gen.ts --date-parser string --numeric-parser string --default-schema public --exclude-pattern schema_migrations",
    "admin:create": "tsx server/db/cli.ts create-owner",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:stripe": "tsx scripts/verify-stripe.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.16",
    "kysely": "^0.29.8",
    "lenis": "^1.3.27",
    "luxon": "^3.7.2",
    "motion": "^12.43.0",
    "nodemailer": "^10.3.1",
    "openai": "7.40.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "twilio": "^6.2.0",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "kysely-codegen": "^0.20.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
